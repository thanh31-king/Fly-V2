-- LOGIC FLY (HEARTBEAT)
-- ============================================================
local function StopFly()
    State.Flying = false
    toggleFlyBtn.Text = "BẬT BAY (F)"
    toggleFlyBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 48)
    toggleFlyBtn.TextColor3 = Color3.fromRGB(180, 190, 200)
    toggleStroke.Color = Color3.fromRGB(50, 50, 70)
    
    for _, conn in pairs(Connections) do
        if conn then conn:Disconnect() end
    end
    Connections = {}
    
    for _, constraint in pairs(Constraints) do
        if constraint then constraint:Destroy() end
    end
    Constraints = {}
    
    local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
end

local function StartFly()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    State.Flying = true
    toggleFlyBtn.Text = "ĐANG BAY (ON)"
    toggleFlyBtn.BackgroundColor3 = Color3.fromRGB(30, 100, 70)
    toggleFlyBtn.TextColor3 = Color3.new(1, 1, 1)
    toggleStroke.Color = Color3.fromRGB(0, 255, 150)
    
    if hum then hum.PlatformStand = true end
    
    local bv = Instance.new("BodyVelocity")
    bv.Name = "VantaAeroBV"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = root
    table.insert(Constraints, bv)
    
    local bg = Instance.new("BodyGyro")
    bg.Name = "VantaAeroBG"
    bg.P = 9e4
    bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.CFrame = root.CFrame
    bg.Parent = root
    table.insert(Constraints, bg)
    
    local speed = 0
    local conn = RunService.Heartbeat:Connect(function()
        if not State.Flying or not root.Parent or (hum and hum.Health <= 0) then StopFly(); return end
        
        local cam = workspace.CurrentCamera
        local move = Vector3.new()
        
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
        
        if State.Up then move += Vector3.new(0, 1, 0) end
        if State.Down then move -= Vector3.new(0, 1, 0) end
        
        if move.Magnitude > 0 then
            speed = speed + (State.FlySpeed * 0.1)
            if speed > State.FlySpeed then speed = State.FlySpeed end
        else
            speed = speed - (State.FlySpeed * 0.1)
            if speed < 0 then speed = 0 end
        end
        
        if State.Mode == "Vertical" then
            bv.Velocity = Vector3.new(0, (State.Up and 1 or 0) - (State.Down and 1 or 0), 0) * speed
            bg.CFrame = CFrame.new(root.Position)
        elseif State.Mode == "Speed" then
            bv.Velocity = move.Unit * (speed * 3)
            bg.CFrame = cam.CFrame
        else -- Free
            bv.Velocity = move.Unit * speed
            bg.CFrame = cam.CFrame
        end
    end)
    table.insert(Connections, conn)
end

toggleFlyBtn.MouseButton1Click:Connect(function()
    if State.Flying then StopFly() else StartFly() end
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == State.ToggleKey then
        if State.Flying then StopFly() else StartFly() end
    end
end)

