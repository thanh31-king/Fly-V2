local function createModeBtn(text, modeName, xScale, xOffset)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.33, -4, 1, -4)
    btn.Position = UDim2.new(xScale, xOffset, 0, 2)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(180, 180, 190)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = modeContainer
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    btn.MouseButton1Click:Connect(function()
        for _, child in ipairs(modeContainer:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                child.TextColor3 = Color3.fromRGB(180, 180, 190)
            end
        end
        btn.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
        State.Mode = modeName
    end)
    return btn
end

